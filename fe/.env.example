NEXT_PUBLIC_SITE_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Backend URL config file path (default: {cwd}/.backend-config.json)
# Override for Docker/k8s: mount a volume and set this path
# BACKEND_CONFIG_PATH=/data/backend-config.json

ZITADEL_ISSUER=https://zitadel-domain
ZITADEL_ORG_ID=your-org-id
ZITADEL_CLIENT_ID=your-client-id

NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32

NEXT_PUBLIC_BE_WS_URL=ws://localhost:8080

# Zitadel Service Account (Optional - 설정하면 우선 사용)
# ZITADEL_SERVICE_USER_ID=your-service-user-id
# ZITADEL_SERVICE_KEY_ID=your-key-id
# ZITADEL_SERVICE_KEY=your-base64-encoded-private-key